# Copia este archivo como .env y completa los valores.
# En Supabase: Project Settings → Database → Connection string.

# App en ejecución: pooler en modo transacción (puerto 6543)
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# CLI de Prisma (db pull): conexión directa o pooler en modo sesión (puerto 5432)
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# JWT: genera un secreto largo, por ejemplo con
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="cambia-esto-por-un-secreto-largo"
JWT_EXPIRA_EN="8h"

PORT=3000
