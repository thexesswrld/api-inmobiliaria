// =====================================================================
//  ESQUEMA PRISMA — API INMOBILIARIA
//
//  La fuente de verdad es database/ (tablas, triggers, funciones).
//  Este archivo NO crea tablas: se sincroniza con
//      npx prisma db pull     (lee la BD y actualiza este archivo)
//      npx prisma generate    (regenera el cliente en src/generated)
//  No usar `prisma migrate dev`: no conoce los triggers ni las funciones.
//
//  Por ahora solo están los modelos de autenticación. `db pull` agrega
//  el resto y conserva los nombres puestos con @map / @@map.
// =====================================================================

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Persona {
  id                    Int       @id @default(autoincrement())
  tipoPersona           Int       @map("tipo_persona")
  tipoDocumento         Int       @map("tipo_documento")
  documento             String    @db.VarChar(20)
  nombre                String    @db.VarChar(200)
  apellidoPaterno       String?   @map("apellido_paterno") @db.VarChar(100)
  apellidoMaterno       String?   @map("apellido_materno") @db.VarChar(100)
  correo                String?   @db.VarChar(150)
  telefono              String?   @db.VarChar(20)
  direccion             String?   @db.VarChar(255)
  idPais                Int?      @map("id_pais")
  idDepartamento        Int?      @map("id_departamento")
  idProvincia           Int?      @map("id_provincia")
  idDistrito            Int?      @map("id_distrito")
  estado                Int       @default(1) @db.SmallInt
  idUsuarioCreacion     Int?      @map("id_usuario_creacion")
  idUsuarioModificacion Int?      @map("id_usuario_modificacion")
  fechaCreacion         DateTime  @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
  fechaModificacion     DateTime? @map("fecha_modificacion") @db.Timestamptz(6)

  usuario Usuario?

  @@unique([tipoDocumento, documento], map: "uq_persona_documento")
  @@map("per_persona")
}

model Usuario {
  id                    Int       @id @default(autoincrement())
  username              String    @unique @db.VarChar(50)
  passwordHash          String    @map("password_hash") @db.VarChar(255)
  idPersona             Int       @unique @map("id_persona")
  estado                Int       @default(1) @db.SmallInt
  idUsuarioCreacion     Int?      @map("id_usuario_creacion")
  idUsuarioModificacion Int?      @map("id_usuario_modificacion")
  fechaCreacion         DateTime  @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
  fechaModificacion     DateTime? @map("fecha_modificacion") @db.Timestamptz(6)

  persona  Persona      @relation(fields: [idPersona], references: [id])
  roles    UsuarioRol[]
  sesiones Sesion[]

  @@map("auth_usuario")
}

model Rol {
  id                    Int       @id @default(autoincrement())
  codigo                String    @unique @db.VarChar(50)
  nombre                String    @db.VarChar(100)
  descripcion           String?   @db.VarChar(255)
  estado                Int       @default(1) @db.SmallInt
  idUsuarioCreacion     Int?      @map("id_usuario_creacion")
  idUsuarioModificacion Int?      @map("id_usuario_modificacion")
  fechaCreacion         DateTime  @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
  fechaModificacion     DateTime? @map("fecha_modificacion") @db.Timestamptz(6)

  usuarios UsuarioRol[]
  permisos RolPermiso[]

  @@map("auth_rol")
}

model UsuarioRol {
  id                    Int       @id @default(autoincrement())
  idUsuario             Int       @map("id_usuario")
  idRol                 Int       @map("id_rol")
  estado                Int       @default(1) @db.SmallInt
  idUsuarioCreacion     Int?      @map("id_usuario_creacion")
  idUsuarioModificacion Int?      @map("id_usuario_modificacion")
  fechaCreacion         DateTime  @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
  fechaModificacion     DateTime? @map("fecha_modificacion") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [idUsuario], references: [id])
  rol     Rol     @relation(fields: [idRol], references: [id])

  @@unique([idUsuario, idRol], map: "uq_usuario_rol")
  @@map("auth_usuario_rol")
}

model Permiso {
  id                    Int       @id @default(autoincrement())
  codigo                String    @unique @db.VarChar(100)
  nombre                String    @db.VarChar(100)
  descripcion           String?   @db.VarChar(255)
  modulo                String    @db.VarChar(50)
  estado                Int       @default(1) @db.SmallInt
  idUsuarioCreacion     Int?      @map("id_usuario_creacion")
  idUsuarioModificacion Int?      @map("id_usuario_modificacion")
  fechaCreacion         DateTime  @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
  fechaModificacion     DateTime? @map("fecha_modificacion") @db.Timestamptz(6)

  roles RolPermiso[]

  @@map("auth_permiso")
}

model RolPermiso {
  id                    Int       @id @default(autoincrement())
  idRol                 Int       @map("id_rol")
  idPermiso             Int       @map("id_permiso")
  estado                Int       @default(1) @db.SmallInt
  idUsuarioCreacion     Int?      @map("id_usuario_creacion")
  idUsuarioModificacion Int?      @map("id_usuario_modificacion")
  fechaCreacion         DateTime  @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
  fechaModificacion     DateTime? @map("fecha_modificacion") @db.Timestamptz(6)

  rol     Rol     @relation(fields: [idRol], references: [id])
  permiso Permiso @relation(fields: [idPermiso], references: [id])

  @@unique([idRol, idPermiso], map: "uq_rol_permiso")
  @@map("auth_rol_permiso")
}

model Sesion {
  id                    Int       @id @default(autoincrement())
  idUsuario             Int       @map("id_usuario")
  tokenHash             String    @unique @map("token_hash") @db.VarChar(255)
  ip                    String?   @db.VarChar(45)
  userAgent             String?   @map("user_agent") @db.VarChar(500)
  fechaInicio           DateTime  @default(now()) @map("fecha_inicio") @db.Timestamptz(6)
  fechaFin              DateTime? @map("fecha_fin") @db.Timestamptz(6)
  estado                Int       @default(1) @db.SmallInt
  idUsuarioCreacion     Int?      @map("id_usuario_creacion")
  idUsuarioModificacion Int?      @map("id_usuario_modificacion")
  fechaCreacion         DateTime  @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
  fechaModificacion     DateTime? @map("fecha_modificacion") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [idUsuario], references: [id])

  @@map("auth_sesiones")
}
